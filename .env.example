# Optional: serve one portable database instead of a generation directory.
# ARCHIVE_SQLITE_PATH=/absolute/path/archive.sqlite
# ARCHIVE_DIR=/absolute/path/.archive

# Optional MCP Streamable HTTP (stdio is the default).
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=3000
# MCP_AUTH_TOKEN=replace-with-a-secret
# MCP_ALLOWED_HOSTS=archive.example.com
# MCP_ALLOWED_ORIGINS=https://your-client.example.com

# Optional S3-compatible input/publication. Keep real values in ignored .env.
# S3_ENDPOINT=http://localhost:9000
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_SESSION_TOKEN=optional-session-token
