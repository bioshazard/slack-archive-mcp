{
  "name": "slack-archive-mcp",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "ingest": "bun src/cli.ts ingest",
    "search": "bun src/cli.ts search",
    "status": "bun src/cli.ts status",
    "verify": "bun src/cli.ts verify",
    "mcp": "bun src/mcp.ts",
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test ./tests",
    "smoke": "bun scripts/smoke.ts",
    "configure:mcp": "bun scripts/configure-mcp.ts",
    "build:mcp": "bun build src/mcp.ts --target=bun --outdir dist",
    "build:cli": "bun build src/cli.ts --target=bun --outdir dist",
    "docker:build": "docker build -f Dockerfile.mcp -t slack-archive-mcp:local .",
    "docker:smoke": "bun scripts/docker-smoke.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "effect": "4.0.5",
    "yauzl": "3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.10",
    "@types/yauzl": "3.4.0",
    "fflate": "0.8.3",
    "typescript": "^5.9.0"
  },
  "packageManager": "bun@1.4.0",
  "license": "MIT",
  "description": "Portable Slack export materialization and read-only MCP search with Effect 4 and SQLite",
  "repository": {
    "type": "git",
    "url": "https://github.com/bioshazard/slack-archive-mcp.git"
  },
  "homepage": "https://github.com/bioshazard/slack-archive-mcp",
  "bugs": "https://github.com/bioshazard/slack-archive-mcp/issues"
}
